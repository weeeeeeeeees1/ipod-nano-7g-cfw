@@ -102,19 +108,31 @@ static int tmr_tstat_shift(int n)
     return (7 - n) * 8;
 }
 
+static uint64_t tmr_rate(Nano7TimerChan *c)
+{
+    return c->n == TMR_CH_E && c->s->linux_timer_e_irq ?
+           TMR_LINUX_E_HZ : TMR_HZ;
+}
+
 static int64_t tmr_period_ns(Nano7TimerChan *c)
