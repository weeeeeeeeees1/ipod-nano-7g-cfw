+    if (s->linux_timer_e_irq) {
+        return s->usec_base * 2 + nano7_now_ns() / 500;
+    }
     return s->usec_base + nano7_now_ns() / 1000;
 }
 
@@ -164,11 +190,10 @@ static uint64_t tmr_read(void *opaque, hwaddr offset, unsigned size)
     hwaddr reg;
     int n;
 
