 {
-    bool level = s->tstat != 0;
+    uint32_t shared_pending = s->tstat;
+    bool level;
     int n;
 
+    if (s->linux_timer_e_irq) {
+        qemu_set_irq(s->linux_timer_e_irq, (s->tstat & TMR_E_PENDING) != 0);
+        shared_pending &= ~TMR_E_PENDING;
+    }
+    level = shared_pending != 0;
     for (n = 0; n < 4; n++) {
         level |= (s->ch[n].con & 0x70000) != 0;
     }
@@ -137,6 +155,11 @@ static void tmr_expire(void *opaque)
     } else {
         s->tstat |= en << tmr_tstat_shift(c->n);
     }
+    if (c->n == TMR_CH_E && s->linux_timer_e_irq) {
+        c->cmd &= ~1u; /* N31 Linux programs Timer E as a one-shot. */
+        tmr_update(s);
+        return;
+    }
