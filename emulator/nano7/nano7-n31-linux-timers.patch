     s->irq = irq;
+    s->linux_timer_e_irq = linux_timer_e_irq;
     s->usec_base = usec_base;
     for (n = 0; n < TMR_NCH; n++) {
         s->ch[n].s = s;
@@ -321,4 +361,11 @@ void nano7_timer_attach(MemoryRegion *parent, hwaddr base, qemu_irq irq,
     vmstate_register_any(NULL, &vmstate_tmr, s);
     memory_region_init_io(&s->mr, NULL, &tmr_ops, s, "nano7.tmr", TMR_SIZE);
