-    int64_t ns = muldiv64(ticks, NANOSECONDS_PER_SECOND, TMR_HZ);
+    int64_t ns = muldiv64(ticks, NANOSECONDS_PER_SECOND, tmr_rate(c));
 
     return MAX(ns, TMR_MIN_NS);
