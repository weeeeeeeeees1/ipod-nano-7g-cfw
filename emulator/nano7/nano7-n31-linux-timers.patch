-        return (uint32_t)tmr_usec(s);
-    }
-    if (offset == 0x80) {
-        return (uint32_t)(tmr_usec(s) >> 32);
+    if (offset == 0x80 || offset == 0x84 ||
+        (offset == 0xb4 && !s->linux_timer_e_irq)) {
+        uint64_t ticks = tmr_free_running_ticks(s);
+        return offset == 0x80 ? (uint32_t)(ticks >> 32) : (uint32_t)ticks;
     }
     if (offset == TMR_TSTAT) {
